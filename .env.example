# -----------------------------------------------------------------------------
# BTC OPTIONS BOT — BASIC SETUP
# Copy this file to .env and edit only the values you need.
# -----------------------------------------------------------------------------

# mode = paper (no orders), testnet (demo account), or live (REAL MONEY)
BOT_MODE=paper

# venue = india or global. Use the same venue as your Delta Exchange account/API key.
VENUE=india

# API key/secret. Required only for testnet/live. Keep .env private.
# Prefer *_FILE in Docker/server deployments.
DELTA_API_KEY=
DELTA_API_SECRET=
# DELTA_API_KEY_FILE=/run/secrets/delta_api_key
# DELTA_API_SECRET_FILE=/run/secrets/delta_api_secret

# Live mode refuses to start without this exact confirmation.
LIVE_TRADING_CONFIRMATION=

# Capital definition:
# net_equity = account net equity from Delta wallet balances
# fixed = always use FIXED_CAPITAL below
# available_balance = available balance of CAPITAL_ASSET
CAPITAL_MODE=net_equity
FIXED_CAPITAL=
CAPITAL_ASSET=

# Used only in paper mode.
PAPER_CAPITAL=1000

# -----------------------------------------------------------------------------
# EXACT STRATEGY (do not change unless you intentionally want a different rule)
# -----------------------------------------------------------------------------
EMA_PERIOD=21
CANDLE_RESOLUTION=1h
TARGET_POINTS=1500
INITIAL_CAPITAL_PCT=0.02
ADDITIONAL_CAPITAL_PCT=0.02
ENTRY_TIME_IST=18:30
ADDITIONAL_TIME_IST=01:00
EXIT_TIME_IST=17:20
NO_STOP_LOSS=true

# Option contract selection. The table did not specify strike/expiry.
# Default: ATM strike of the first BTC expiry AFTER tomorrow's 17:20 IST exit.
OPTION_STRIKE_MODE=atm
OPTION_STRIKE_OFFSET=0
OPTION_EXPIRY_MODE=next_after_exit
# Leave blank for automatic selection, or pin e.g. C-BTC-80000-281026.
MANUAL_OPTION_SYMBOL=

# Market symbols. Blank values use safe defaults for the selected venue.
PRICE_SYMBOL=
CANDLE_SYMBOL=
UNDERLYING_ASSET_SYMBOL=BTC

# -----------------------------------------------------------------------------
# EXECUTION / SAFETY
# -----------------------------------------------------------------------------
POLL_SECONDS=1
CATCHUP_MINUTES=10
MAX_MARKET_DATA_AGE_SECONDS=60
MAX_SPREAD_PCT=0.15
MAX_BOOK_SLIPPAGE_PCT=0.10
MIN_OPTION_TURNOVER_USD=0
MIN_EXPIRY_BUFFER_MINUTES=5
MAX_EXPIRY_DAYS=8
ORDER_PRICE_BUFFER_PCT=0.01
EXIT_PRICE_BUFFER_PCT=0.02
FEE_BUFFER_PCT=0.01
ORDER_FILL_TIMEOUT_SECONDS=180
EXIT_REPRICE_SECONDS=5
HTTP_TIMEOUT_SECONDS=15
HTTP_RETRIES=4
ALLOW_EXISTING_POSITION=false
DEDICATED_ACCOUNT=false
MIN_WALLET_EQUITY=0

# Files that control the running bot without editing code.
DATA_DIR=data
LOG_DIR=logs
PAUSE_FILE=
KILL_FILE=

# Local dashboard. Keep on 127.0.0.1 unless you know how to secure it.
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_TOKEN=

# Optional Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
